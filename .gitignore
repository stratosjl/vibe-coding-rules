# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local testing artefacts
/tmp/
*.log

# Secrets / local-only addon overrides
# (the private operator-side addon never sits inside this repo)
*.local.*
!bin/audit-patterns.local.sh.example
.env
.env.*
private/
local-addon/
# operator-private addon; never commit to this public repo
methodology-content/residency-routing.md

# operator-private per-project memory - never publish to this public repo (restored after v1.17.0 regression)
memory/

# operator-private tier-addon overlay slices; never publish to this public repo.
# Deliberately a glob rather than a filename: the public slices are T<n>.md with no
# suffix, so this cannot match one, and it keeps covering an addon slice if it is
# ever renamed. Naming a specific private slice here would also put that name in a
# public file, which is what the operator-side leak guard exists to prevent.
methodology-content/T4-*.md
