{
  "description": "VC-RoE (Vibe Coding · Rules of Engagement) hooks: SessionStart injects the matching slice (since v1.27.0 as up to 3 separate entries, each under Claude Code's per-hook output limit), writes the heartbeat anchor, and acquires a chat-claim for multi-chat-access protection (added v1.3.0); UserPromptSubmit emits the elapsed-time clock tag per D-MET-33 (informational since v1.20.0, 30-minute cadence); PostToolUse mirrors the clock tag during autonomous-work windows where no user prompt fires (added v1.1.0); Stop greps the assistant transcript for the heartbeat sentinel, advances LAST_HEARTBEAT (layered fail-safe per D-MET-41), and refreshes the chat-claim ts (added v1.3.0); SessionEnd releases the chat-claim (added v1.3.0). Renamed from vc-roe at v1.0.0.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py --split",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py --slice-part 1",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py --slice-part 2",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py --slice-part 3",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/stop.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/hooks/session-end.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
